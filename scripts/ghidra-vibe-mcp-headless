#!/usr/bin/env bash
# True headless program-engine API (GhidraMCPHeadlessServer) — separate JVM for
# agents, batch, and GHIDRA_VIBE_ENGINE=sidecar. The native GUI embeds the same
# server in-process via libghidravibe_engine (default GHIDRA_VIBE_ENGINE=inprocess).
# Usage: ghidra-vibe-mcp-headless [--port 8089] [--project PATH] [--program NAME] ...
set -euo pipefail

# When nix copies this script alone into the store, dirname($0) is /nix/store —
# never look only next to $0. Prefer GHIDRA_VIBE_LIB / packaged share tree.
resolve_vibe_lib() {
  local d cand
  if [[ -n "${GHIDRA_VIBE_LIB:-}" && -f "${GHIDRA_VIBE_LIB}/detect-maxmem.sh" ]]; then
    echo "${GHIDRA_VIBE_LIB}"
    return 0
  fi
  d="$(cd "$(dirname "$0")" && pwd)"
  for cand in \
    "${d}/lib/detect-maxmem.sh" \
    "${d}/../share/ghidra-vibe/lib/detect-maxmem.sh" \
    "${d}/../lib/detect-maxmem.sh"
  do
    if [[ -f "$cand" ]]; then
      echo "$(cd "$(dirname "$cand")" && pwd)"
      return 0
    fi
  done
  # GHIDRA_INSTALL_DIR is $out/lib/ghidra → share lives at $out/share/ghidra-vibe/lib
  if [[ -n "${GHIDRA_INSTALL_DIR:-}" && -f "${GHIDRA_INSTALL_DIR}/../../share/ghidra-vibe/lib/detect-maxmem.sh" ]]; then
    echo "$(cd "${GHIDRA_INSTALL_DIR}/../../share/ghidra-vibe/lib" && pwd)"
    return 0
  fi
  echo "detect-maxmem.sh not found (set GHIDRA_VIBE_LIB)" >&2
  exit 1
}

VIBE_LIB="$(resolve_vibe_lib)"
# shellcheck source=lib/detect-maxmem.sh
source "${VIBE_LIB}/detect-maxmem.sh"
MEM="$(detect_ghidra_maxmem)"
# Reject inherited HotSpot JAVA_HOME that SIGBUS on this host.
if [[ -f "${VIBE_LIB}/detect-java.sh" ]]; then
  # shellcheck source=lib/detect-java.sh
  source "${VIBE_LIB}/detect-java.sh"
  if jh="$(detect_ghidra_java_home)"; then
    export JAVA_HOME="$jh"
  fi
fi
# AWT headless=true: engine JVM has no Swing window (native UI is the GUI).
VMARG_LIST="${GHIDRA_VIBE_VMARGS:--XX:ParallelGCThreads=2 -XX:CICompilerCount=2 -Djava.awt.headless=true -Dghidra.vibe.nativeUi=1 }"

# Isolate settings so ~/Library/ghidra/*/Extensions/GhidraMCP cannot collide with
# the bundled Extensions/GhidraMCP in GHIDRA_INSTALL_DIR (in-process + headless).
VIBE_SETTINGS="${GHIDRA_VIBE_SETTINGS_DIR:-$HOME/Library/ghidra-vibe/settings}"
mkdir -p "${VIBE_SETTINGS}"
VMARG_LIST="${VMARG_LIST} -Dapplication.settingsdir=${VIBE_SETTINGS} "

# Pre-accept so Java never raises Swing UserAgreementDialog (native UI owns consent).
seed_pref() {
  local pref="$1"
  mkdir -p "$(dirname "$pref")"
  if [[ -f "$pref" ]] && grep -q '^USER_AGREEMENT=ACCEPT' "$pref" 2>/dev/null; then
    return 0
  fi
  if [[ -f "$pref" ]]; then
    grep -v '^USER_AGREEMENT=' "$pref" >"${pref}.tmp" 2>/dev/null || true
    echo 'USER_AGREEMENT=ACCEPT' >>"${pref}.tmp"
    mv "${pref}.tmp" "$pref"
  else
    echo 'USER_AGREEMENT=ACCEPT' >"$pref"
  fi
}
seed_pref "${VIBE_SETTINGS}/preferences"
for pref in "$HOME"/Library/ghidra/*/preferences; do
  [[ -f "$pref" ]] || continue
  seed_pref "$pref"
done

resolve_ghidra_home() {
  if [[ -n "${GHIDRA_INSTALL_DIR:-}" && -x "${GHIDRA_INSTALL_DIR}/support/launch.sh" ]]; then
    echo "${GHIDRA_INSTALL_DIR}"
    return
  fi
  if [[ -n "${GHIDRA_VIBE_BIN:-}" ]]; then
    local real
    real="$(readlink -f "${GHIDRA_VIBE_BIN}" 2>/dev/null || readlink "${GHIDRA_VIBE_BIN}" 2>/dev/null || echo "${GHIDRA_VIBE_BIN}")"
    echo "$(cd "$(dirname "$real")/../lib/ghidra" 2>/dev/null && pwd)"
    return
  fi
  echo "Set GHIDRA_INSTALL_DIR to a vibe Ghidra tree" >&2
  exit 1
}

SRC="$(resolve_ghidra_home)"
MCP_JAR="$(find "${SRC}/Ghidra/Extensions/GhidraMCP/lib" -name 'GhidraMCP-*.jar' 2>/dev/null | head -1 || true)"
if [[ -z "${MCP_JAR}" || ! -f "${MCP_JAR}" ]]; then
  echo "GhidraMCP jar not found under ${SRC}/Ghidra/Extensions/GhidraMCP/lib" >&2
  exit 1
fi

# Stable runtime (not /tmp/…-$$). Reuse across restarts; rebuild if the
# install tree changes. launchd / MCP ensure share this directory.
if [[ -z "${GHIDRA_VIBE_RUNTIME_HOME:-}" ]]; then
  if [[ "$(uname -s)" == "Darwin" ]]; then
    GHIDRA_VIBE_RUNTIME_HOME="${HOME}/Library/Caches/ghidra-vibe/runtime"
  else
    GHIDRA_VIBE_RUNTIME_HOME="${XDG_CACHE_HOME:-${HOME}/.cache}/ghidra-vibe/runtime"
  fi
fi
RUNTIME="${GHIDRA_VIBE_RUNTIME_HOME}"
if [[ -f "${RUNTIME}/.ghidra-install" ]]; then
  prev="$(cat "${RUNTIME}/.ghidra-install" 2>/dev/null || true)"
  if [[ "$prev" != "${SRC}" ]]; then
    rm -rf "${RUNTIME}"
  fi
fi
if [[ ! -x "${RUNTIME}/support/launch.sh" && ! -f "${RUNTIME}/support/.launch.sh-wrapped" ]]; then
  rm -rf "${RUNTIME}"
  mkdir -p "${RUNTIME}/Ghidra/patch"
  # Symlink install; materialize patch/ with MCP jar for early classpath.
  # Materialize support/ as real files so headless can set JAVA_HOME_OVERRIDE
  # (nix store trees are read-only).
  for name in "${SRC}"/*; do
    base="$(basename "$name")"
    if [[ "$base" == "Ghidra" ]]; then
      mkdir -p "${RUNTIME}/Ghidra"
      for n2 in "${SRC}/Ghidra"/*; do
        b2="$(basename "$n2")"
        if [[ "$b2" == "patch" ]]; then
          cp -f "${MCP_JAR}" "${RUNTIME}/Ghidra/patch/$(basename "${MCP_JAR}")"
        else
          ln -sfn "$n2" "${RUNTIME}/Ghidra/${b2}"
        fi
      done
    elif [[ "$base" == "support" ]]; then
      mkdir -p "${RUNTIME}/support"
      # Prefer bash wrapper over Mach-O trampoline for agent/headless.
      if [[ -f "${name}/.launch.sh-wrapped" ]]; then
        cp -f "${name}/.launch.sh-wrapped" "${RUNTIME}/support/launch.sh"
        chmod +x "${RUNTIME}/support/launch.sh"
      else
        cp -f "${name}/launch.sh" "${RUNTIME}/support/launch.sh" 2>/dev/null || \
          ln -sfn "${name}/launch.sh" "${RUNTIME}/support/launch.sh"
        chmod +x "${RUNTIME}/support/launch.sh" 2>/dev/null || true
      fi
      if [[ -f "${name}/launch.properties" ]]; then
        cp -f "${name}/launch.properties" "${RUNTIME}/support/launch.properties"
      fi
      # Keep other support helpers available via symlink
      for s in "${name}"/*; do
        sb="$(basename "$s")"
        [[ "$sb" == "launch.sh" || "$sb" == "launch.properties" || "$sb" == ".launch.sh-wrapped" ]] && continue
        ln -sfn "$s" "${RUNTIME}/support/${sb}"
      done
    else
      ln -sfn "$name" "${RUNTIME}/${base}"
    fi
  done
fi

# Headless provider expects project-relative paths like /AppKit, not bare AppKit.
args=()
while [[ $# -gt 0 ]]; do
  if [[ "$1" == "--program" && $# -ge 2 && "$2" != /* && "$2" != -* ]]; then
    args+=(--program "/$2")
    shift 2
  else
    args+=("$1")
    shift
  fi
done

echo "ghidra-vibe-mcp-headless MAXMEM=$MEM runtime=$RUNTIME" >&2
# Ensure MCP jar is always in patch/ even when RUNTIME is reused.
mkdir -p "${RUNTIME}/Ghidra/patch"
cp -f "${MCP_JAR}" "${RUNTIME}/Ghidra/patch/$(basename "${MCP_JAR}")"
printf '%s\n' "${SRC}" >"${RUNTIME}/.ghidra-install"

# Headless / agent runs have no TTY for LaunchSupport JDK prompts. Force
# JAVA_HOME_OVERRIDE into the runtime launch.properties (symlink trees are
# read-only — materialize a writable copy). Also seed java_home.save under
# application.settingsdir when JAVA_HOME is set.
if [[ -n "${JAVA_HOME:-}" && -x "${JAVA_HOME}/bin/java" ]]; then
  LP_SRC="${RUNTIME}/support/launch.properties"
  if [[ -f "$LP_SRC" ]]; then
    LP_WRITABLE="${RUNTIME}/support/launch.properties.wwn"
    if [[ -L "$LP_SRC" || ! -w "$LP_SRC" ]]; then
      cp -f "$LP_SRC" "$LP_WRITABLE"
      rm -f "$LP_SRC"
      mv "$LP_WRITABLE" "$LP_SRC"
    fi
    if grep -q '^JAVA_HOME_OVERRIDE=' "$LP_SRC" 2>/dev/null; then
      # portable in-place replace without relying on GNU sed -i
      awk -v jh="$JAVA_HOME" '
        BEGIN { done=0 }
        /^JAVA_HOME_OVERRIDE=/ {
          print "JAVA_HOME_OVERRIDE=" jh
          done=1
          next
        }
        { print }
        END { if (!done) print "JAVA_HOME_OVERRIDE=" jh }
      ' "$LP_SRC" >"${LP_SRC}.tmp" && mv "${LP_SRC}.tmp" "$LP_SRC"
    else
      printf '\nJAVA_HOME_OVERRIDE=%s\n' "$JAVA_HOME" >>"$LP_SRC"
    fi
  fi
  mkdir -p "${VIBE_SETTINGS}/ghidra"
  for verdir in "${VIBE_SETTINGS}/ghidra"/ghidra_*; do
    [[ -d "$verdir" ]] || continue
    printf '%s\n' "$JAVA_HOME" >"${verdir}/java_home.save"
  done
  # Common layout when settingsdir is used as application.settingsdir
  mkdir -p "${VIBE_SETTINGS}/ghidra/ghidra_12.1.2_NIX"
  printf '%s\n' "$JAVA_HOME" >"${VIBE_SETTINGS}/ghidra/ghidra_12.1.2_NIX/java_home.save"
fi

# Prefer the bash launch wrapper when the store path ships a Mach-O trampoline
# that cannot resolve JDK without a TTY.
LAUNCH="${RUNTIME}/support/launch.sh"
if [[ -f "${RUNTIME}/support/.launch.sh-wrapped" ]]; then
  LAUNCH="${RUNTIME}/support/.launch.sh-wrapped"
fi

# Application name must be a known Ghidra layout ("Ghidra") so patch/ + Extensions
# land on the launcher classpath. "Ghidra-MCP-Headless" is not a stock app id and
# yields ClassNotFound for the headless server main.
# With `set -u`, empty "${args[@]}" is an unbound error — expand only when set.
exec "${LAUNCH}" fg jdk Ghidra "$MEM" "$VMARG_LIST" \
  com.xebyte.headless.GhidraMCPHeadlessServer ${args[@]+"${args[@]}"}
